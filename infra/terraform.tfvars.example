# Copy this file to terraform.tfvars and edit the values below.
# terraform.tfvars is .gitignore'd — it's meant to hold your own
# account/region choices, not to be committed alongside the .tf files.

aws_region = "us-east-1"
stage_name = "prod"

# HR Lookup application — cognito_domain_prefix must be globally unique
# across all AWS accounts (Cognito domains share one global namespace).
cognito_domain_prefix = "hr-lookup-yourname"
student_name           = "Your Name"
